{
	"schemaVersion": 1,
	"id": "chunky-friends",
	"version": "${version}",
	"name": "Chunky Friends",
	"description": "A server-side Minecraft mod that orders and prioritizes chunky pregeneration based on player locations",
	"authors": [
		"ExodusOTH"
	],
	"contact": {
		"homepage": "https://github.com/OnTheHill-Studios",
		"sources": "https://github.com/OnTheHill-Studios/com.onthehill.chunky-friends"
	},
	"license": "MIT-License",
	"icon": "assets/chunky-friends/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.onthehill.chunkyfriends.ChunkyFriends"
		],
		"client": [
			"com.onthehill.chunkyfriends.client.ChunkyFriendsClient"
		],
		"fabric-datagen": [
			"com.onthehill.chunkyfriends.client.ChunkyFriendsDataGenerator"
		],
		"modmenu": [
			"com.onthehill.chunkyfriends.client.ChunkyFriendsModMenu"
		]
	},
	"mixins": [
		"chunky-friends.mixins.json",
		{
			"config": "chunky-friends.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*",
		"chunky": ">=1.3.38"
	},
	"suggests": {
		"modmenu": ">=20.0.0"
	}
}