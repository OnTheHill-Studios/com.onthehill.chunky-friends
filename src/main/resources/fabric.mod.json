{
	"schemaVersion": 1,
	"id": "chunky-shared",
	"version": "${version}",
	"name": "Chunky Shared",
	"description": "A server-side Minecraft mod that orders and prioritizes chunky pregeneration based on player locations",
	"authors": [
		"ExodusOTH"
	],
	"contact": {
		"homepage": "https://github.com/OnTheHill-Studios",
		"sources": "https://github.com/OnTheHill-Studios/com.othstudios.chunkyshared"
	},
	"license": "MIT-License",
	"icon": "assets/chunky-shared/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.othstudios.chunkyshared.ChunkyShared"
		],
		"client": [
			"com.othstudios.chunkyshared.client.ChunkySharedClient"
		],
		"fabric-datagen": [
			"com.othstudios.chunkyshared.client.ChunkySharedDataGenerator"
		],
		"modmenu": [
			"com.othstudios.chunkyshared.client.ChunkySharedModMenu"
		]
	},
	"mixins": [
		"chunky-shared.mixins.json",
		{
			"config": "chunky-shared.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*",
		"chunky": ">=1.3.38"
	},
	"suggests": {
		"modmenu": ">=20.0.0"
	}
}